<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements">

    <ui:Label text="VALIDATION DATA"  class="header"/>

    <ui:VisualElement class="section section-green">

        <ui:Label text="Validation Requirements"  class="section-title"/>
        <ui:Label text="Configure the number of validation iterations" class="section-description"/>

        <uie:PropertyField binding-path="validationRequirements"/>

    </ui:VisualElement>

</ui:UXML>